# ============================================================
#  MyBankProject - .gitignore general (backend + frontend)
# ============================================================

# ---------- Secretos y configuración local ----------
# Contraseña de MySQL y otras claves locales del backend
bckdbank/config/
# Variables de entorno con secretos (el .env del frontend NO tiene secretos y sí se sube)
.env.local
.env.*.local
*.local
bckdbank/.env
bckdbank/.env.*

# ---------- Sistema operativo ----------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ---------- Editores e IDEs ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
#  BACKEND (Spring Boot / Maven) - carpeta bckdbank/
# ============================================================
bckdbank/target/
bckdbank/HELP.md
bckdbank/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Spring Tool Suite / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ============================================================
#  FRONTEND (React + Vite) - carpeta bckdbank-front/
# ============================================================
node_modules/
bckdbank-front/dist/
bckdbank-front/dist-ssr/
bckdbank-front/coverage/
bckdbank-front/node_modules/.tmp/
*.tsbuildinfo
